FROM alpine:3.19

# Install all dependencies in one layer
RUN apk add --no-cache \
        python3 \
        bash \
        nginx \
        tini \
        curl \
        docker-cli \
        docker-cli-compose \
    && rm -f /etc/alpine-release \
    && mkdir -p /opt/microsys \
                /opt/microsys/bin \
                /opt/microsys/web \
                /etc/1panel \
                /var/log/nginx \
                /var/lib/nginx/tmp/{client_body,proxy,fastcgi,uwsgi,scgi} \
                /var/cache/nginx \
                /run

# Copy all binaries and config
COPY bin/1panel-core      /opt/microsys/bin/1panel-core
COPY bin/1panel-agent     /opt/microsys/bin/1panel-agent
COPY bin/agent_relay.py   /opt/microsys/bin/agent_relay.py
COPY docker/microsys.conf /etc/nginx/http.d/microsys.conf
COPY docker/entrypoint.sh /opt/microsys/bin/entrypoint.sh
COPY web/                 /opt/microsys/web/

# Runtime config
RUN chmod +x /opt/microsys/bin/* \
    && echo 'root:x:0:0:root:/root:/bin/sh' > /etc/passwd \
    && echo 'nginx:x:101:101:nginx:/var/cache/nginx:/sbin/nologin' >> /etc/passwd \
    && echo 'root:x:0:' > /etc/group \
    && echo 'nginx:x:101:' >> /etc/group \
    && echo 'passwd: files\ngroup: files\nshadow: files\nhosts: files dns' > /etc/nsswitch.conf \
    && rm -f /etc/nginx/conf.d/default.conf /etc/nginx/http.d/default.conf

# Volumes for persistent state
VOLUME ["/opt/microsys", "/etc/1panel", "/usr/local/bin"]

EXPOSE 8887

# tini reaps zombies and forwards signals
ENTRYPOINT ["/sbin/tini", "--", "/opt/microsys/bin/entrypoint.sh"]
